# Copy file này thành .env và điền giá trị thực


# ─── MySQL (Docker) ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=vnpthack
MYSQL_USER=vnpthack_user
MYSQL_PASSWORD=changeme_vnpt

# DATABASE_URL được set tự động bởi docker-compose khi chạy container
# Khi dev local không dùng Docker, dùng SQLite:
DATABASE_URL=sqlite:///./vnpthack.db

# ─── MinIO (Docker S3-compatible storage) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_BUCKET=vnpthack-videos

# Khi dev local, trỏ vào localhost:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio
MINIO_SECURE=false

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=30

# ─── VNPT APIs ────────────────────────────────────────────────────────────────
VNPT_USERNAME=your_username
VNPT_PASSWORD=your_password
VNPT_CLIENT_ID=your_client_id
VNPT_CLIENT_SECRET=your_client_secret

# Token dùng chung nếu copy từ console (Bỏ qua OAuth đăng nhập)
VNPT_GLOBAL_ACCESS_TOKEN=your_global_access_token

# VNPT SmartReader (OCR)
VNPT_OCR_TOKEN_ID=your_ocr_token_id
VNPT_OCR_TOKEN_KEY=your_ocr_token_key

# VNPT SmartVoice (STT & Summary)
VNPT_STT_TOKEN_ID=your_stt_token_id
VNPT_STT_TOKEN_KEY=your_stt_token_key

# VNPT SmartVision (Object Detection)
VNPT_VISION_TOKEN_ID=your_vision_token_id
VNPT_VISION_TOKEN_KEY=your_vision_token_key

# VNPT SmartBot (Chatbot Reviewer)
VNPT_BOT_TOKEN_ID=your_bot_token_id
VNPT_BOT_TOKEN_KEY=your_bot_token_key
VNPT_BOT_ID=your_bot_id




